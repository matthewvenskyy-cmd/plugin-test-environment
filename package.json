{
  "name": "minecraft-plugin-testing-environment",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Headless Paper server test harness for local Minecraft plugins.",
  "scripts": {
    "setup": "node src/harness.js setup",
    "build": "node src/harness.js build",
    "server": "node src/harness.js server",
    "test": "npm run selftest && npm run smoke && npm run scenarios",
    "selftest": "node src/harness.js selftest",
    "validate:config": "node src/harness.js validate-config",
    "list:scenarios": "node src/harness.js list-scenarios",
    "list:expected-failures": "node src/harness.js list-expected-failures",
    "list:failures": "node src/harness.js list-failures",
    "list:areas": "node src/harness.js list-areas",
    "rerun:failures": "node src/harness.js rerun-failures --no-build",
    "scenarios": "node src/harness.js scenarios --no-build",
    "scenarios:build": "npm run build && npm run scenarios",
    "smoke": "node src/harness.js smoke",
    "clean": "node src/harness.js clean"
  },
  "dependencies": {
    "fast-glob": "^3.3.3",
    "mineflayer": "^4.37.1"
  },
  "devDependencies": {}
}
