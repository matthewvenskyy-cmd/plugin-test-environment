  "projectsRoot": "..",
  "projects": [
    {
      "name": "adminplugin",
      "path": "../adminplugin",
      "build": "gradle",
      "jar": "build/libs/*.jar",
      "plugin": "AdminPlugin",
      "consoleCommands": [
        "version AdminPlugin"
      ],
      "botCommands": [
        "/adminplugin"
      ]
    },
    {
      "name": "Bigger-Crafting-Table",
      "path": "../Bigger-Crafting-Table",
